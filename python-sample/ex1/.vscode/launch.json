  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Python Lambda (Local)",
      "type": "debugpy",
      "request": "launch",
      "module": "lambda_local",
      "args": [
        "-f",
        "lambda_handler",
        "${workspaceFolder}\\my-python-lambda\\lambda_function.py",
        "${workspaceFolder}\\my-python-lambda\\event.json",
        "-t", "10"
      ],
      "console": "integratedTerminal"
    }
  ]
}